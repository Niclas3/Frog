ifeq ($(FROG_TEST_PROFILE),time-smoke)
ifneq ($(QEMU_TEST),1)
$(error time-smoke requires QEMU_TEST=1)
endif
MACRO_DEBUG += -DCONFIG_FROG_TEST_TIME
