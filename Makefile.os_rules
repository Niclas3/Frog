AS := nasm
CC := gcc
LD := ld

abs-src := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/core)
BUILD_DIR := $(abs-src)/build
DEPDIR := $(abs-src)/.deps

OUTBIN := out.bin


# -f elf   outfile format is elf_i386
A_FLAG := -f elf

AS_INCLUDE := boot.inc
AS_DEBUG_FLAG += -g

# --------------------
# C options
# -c   do not link
# -m32 outfile format is elf_i386
# -lc  link with libc
# -fno-stack-protector Do not check stack at gcc stage instead of ld
# -fno-builtin
C_WARNG += -Wstrict-prototypes 
C_WARNG += -Wmissing-prototypes
C_WARNG += -Wextra
C_WARNG += -Wall
C_OUT_FMT += -m32
C_MARCH386 += -march=i386
C_FNO_FLAG += -fno-stack-protector 
C_FNO_FLAG += -fno-builtin
C_NO_LINK += -c
C_NO_GOT += -fno-pie
C_SECTION_GC += -ffunction-sections -fdata-sections
C_DEBUG := -g
# C_ASAN += -fsanitize=address
C_ASAN +=

# C_OPTIM += -O1
# C_OPTIM += -Og
C_OPTIM += -O0
# generate files that encode make rules for the .h dependencies
# more -M* things please `man gcc`
# -MT: Name of the target
# -MMD: List user header files
# -MD : list all header files include system header files
# -MP : add phony targets
# -MF : Name of the file
DEPFLAGS = -MMD -MP -MT $@ -MF

ifneq ($(SKIP_DEPENDENCIES),1)
ifneq ($(filter $(abs-src)/%,$(CURDIR)),)
.DEFAULT_GOAL := all
-include $(wildcard $(DEPDIR)/*.d)
endif
endif

# this variable is for choosing target arch, like arm, x86 etc..
ARCH_CUR := x86
PLTF_CUR := pc
# all include dirs
# Main include header files
INCLUDES += $(abs-src)/include
# Arch include header files
INCLUDES += $(abs-src)/arch/$(ARCH_CUR)/include
# Platform include header files
INCLUDES += $(abs-src)/arch/$(PLTF_CUR)/include

BUILD := ..

#gcc compile time Macro
MACRO_DEBUG := -DCONFIG_DEBUG
MACRO_DEBUG += -DCONFIG_POSION_MEMORY
ifeq ($(QEMU_TEST),1)
MACRO_DEBUG += -DCONFIG_QEMU_TEST
endif
ifeq ($(FROG_TEST_PROFILE),process-smoke)
ifneq ($(QEMU_TEST),1)
$(error process-smoke requires QEMU_TEST=1)
endif
MACRO_DEBUG += -DCONFIG_FROG_TEST_PROCESS
endif
ifeq ($(FROG_TEST_PROFILE),user-smoke)
ifneq ($(QEMU_TEST),1)
$(error user-smoke requires QEMU_TEST=1)
endif
MACRO_DEBUG += -DCONFIG_FROG_TEST_USER
endif
