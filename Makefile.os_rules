ifeq ($(FROG_TEST_PROFILE),disk-smoke)
ifneq ($(QEMU_TEST),1)
$(error disk-smoke requires QEMU_TEST=1)
endif
MACRO_DEBUG += -DCONFIG_FROG_TEST_DISK
ifeq ($(FROG_TEST_STAGE),prepare)
MACRO_DEBUG += -DCONFIG_FROG_TEST_STAGE_PREPARE
else ifeq ($(FROG_TEST_STAGE),verify)
MACRO_DEBUG += -DCONFIG_FROG_TEST_STAGE_VERIFY
else ifeq ($(FROG_TEST_STAGE),corrupt)
MACRO_DEBUG += -DCONFIG_FROG_TEST_STAGE_CORRUPT
else
$(error FROG_TEST_STAGE must be prepare, verify, or corrupt for disk-smoke)
endif
endif
C_DMACRO := $(MACRO_DEBUG)

C_OPT := $(C_NO_LINK) $(C_NO_GOT) $(C_SECTION_GC) $(C_WARNG) $(C_MARCH386) $(C_OUT_FMT) $(C_FNO_FLAG) $(C_DEBUG) $(C_OPTIM) $(C_ASAN)
C_FLAG = $(C_OPT) $(C_DMACRO) $(foreach D, $(INCLUDES), -I$(D)) $(DEPFLAGS)

# Object targets live in the shared build directory, so make can compare the
# real output timestamps with their source and generated header dependencies.
build-obj-y = $(addprefix $(BUILD_DIR)/,$(obj-y))

$(BUILD_DIR)/%.o: %.c
	$(CC) $(C_FLAG) $(DEPDIR)/$*.d -o $@ $(abspath $<)


# ld things 
#
# -s strip-all Omit all symbol information from the output file.
# -m Emulate the mulation linker. You can list the available emulations
#    with the --verbose or -V options.
#         GNU ld (GNU Binutils for Ubuntu) 2.38
#             Supported emulations:
#              elf_x86_64 elf32_x86_64 elf_i386 elf_iamcu elf_l1om
#              elf_k1om i386pep i386pe
# -lc link libc use dynamic linking
# -Ttext set start virtual address
# -M print a map
# LD_FLAG := -s -m elf_i386 -Ttext $(CORE_VADDR) 
CORE_VADDR := 0xc0060000
LD_FLAG := -s --gc-sections -m elf_i386 -T ./scripts/kernel_dbg.ld
LD_DEBUG_FLAG := -M --gc-sections -m elf_i386 -T ./scripts/kernel_dbg.ld
